#!/usr/bin/env zsh
# =======================================================
# 个人私有配置模板 (QuanQuan.rc)
# 
# 位于项目根目录 ~/.config/zsh/QuanQuan.rc
# 已加入 .gitignore，完全独立，永远不会被 Git 提交或上传！
#
# 安装后可在此配置你的私有 API Key、Token 以及个性化环境变量。
# =======================================================

# ----------------- 0. 命令行 Prompt 前缀自定义 (支持完全自定义) -----------------
# 方式 1 (推荐)：完全自定义前缀（包含括号、Emoji、符号等任意格式）
# export PROMPT_TAG="[⭕️ MacOS-M4]"      # 显示效果: [⭕️ MacOS-M4]
# export PROMPT_TAG="(🍎 Mac M4)"        # 显示效果: (🍎 Mac M4)
# export PROMPT_TAG="⭕️ MacOS-M4"        # 显示效果: ⭕️ MacOS-M4 (无方括号)

# 方式 2：仅指定系统名称（不写括号时系统会自动补齐中括号 []）
# export PROMPT_OS_NAME="MacOS-M4"       # 显示效果: [MacOS-M4]

# ----------------- 1. AI API Keys -----------------
# export OPENAI_API_KEY="sk-..."
# export OPENAI_BASE_URL="https://api.openai.com/v1"

# export DEEPSEEK_API_KEY="sk-..."
# export ANTHROPIC_API_KEY="sk-..."
# export ANTHROPIC_BASE_URL="https://api-slb.micuapi.ai"
# export GEMINI_API_KEY="AIzaSy..."
# export CODESTRAL_API_KEY="..."
# export OPENROUTER_API_KEY="sk-or-v1-..."
# export DASHSCOPE_API_KEY="sk-..."

# ----------------- 2. 代码托管 Token -----------------
# export GITHUB_TOKEN="github_pat_..."
# export GITLAB_TOKEN="glpat-..."
# export GITLAB_BASE_URL="https://git.yourcompany.com"

# ----------------- 3. 本地个性化 PATH / 环境变量 -----------------
# export JAVA_HOME="/Library/Java/JavaVirtualMachines/zulu-8.jdk/Contents/Home"
# export PNPM_HOME="$HOME/Library/pnpm"
# export PATH="$HOME/go/bin:$PATH"
